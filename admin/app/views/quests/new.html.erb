<div class="card">
  <h2>New Quest for "<%= @collab.name %>"</h2>
  <%= form_with url: collab_quests_path(@collab), method: :post, local: true do |f| %>
    <label>Title</label>
    <select name="quest[title_id]">
      <% Array(@collab.title_ids).each do |tid| %><option value="<%= tid %>"><%= tid %></option><% end %>
    </select>
    <label>Name</label>           <%= f.text_field "quest[name]" %>
    <label>Reward (currency)</label><%= f.number_field "quest[reward_amount]" %>
    <p><%= f.submit "Create", class: "btn" %></p>
  <% end %>
</div>

