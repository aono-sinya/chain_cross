<div class="card">
  <h2>New Title</h2>
  <%= form_with url: titles_path, method: :post, local: true do |f| %>
    <label>Code (e.g. title-a)</label>
    <%= f.text_field "title[code]" %>
    <label>Name</label>
    <%= f.text_field "title[name]" %>
    <label>Endpoint (mock URL, e.g. http://game-a:4001)</label>
    <%= f.text_field "title[endpoint]" %>
    <p><%= f.submit "Create", class: "btn" %></p>
  <% end %>
</div>

