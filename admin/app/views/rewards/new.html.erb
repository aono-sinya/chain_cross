<div class="card">
  <h2>New Reward for "<%= @collab.name %>"</h2>
  <%= form_with url: collab_rewards_path(@collab), method: :post, local: true do |f| %>
    <label>Title</label>
    <select name="reward[title_id]">
      <% Array(@collab.title_ids).each do |tid| %><option value="<%= tid %>"><%= tid %></option><% end %>
    </select>
    <label>Name</label> <%= f.text_field "reward[name]" %>
    <label>Cost</label> <%= f.number_field "reward[cost]" %>
    <p><%= f.submit "Create", class: "btn" %></p>
  <% end %>
</div>

